const express = require("express");
const { InferenceClient } = require("@huggingface/inference");
const app = express();
app.use(express.json({ limit: "10mb" }));
app.use(express.static("public"));
const MODEL = process.env.HF_MODEL || "black-forest-labs/FLUX.1-schnell";
app.post("/api/generate", async (req, res) => {
  try {
    const token = process.env.HF_TOKEN;
    if (!token) return res.status(500).json({ error: "HF_TOKEN belum diset" });
    const prompt = (req.body.prompt || "").trim();
    if (!prompt) return res.status(400).json({ error: "Prompt kosong" });
    let width = 1024, height = 1024;
    if (prompt.includes("rasio 16:9")) { width = 1024; height = 576; }
    if (prompt.includes("rasio 9:16")) { width = 576; height = 1024; }
    const client = new InferenceClient(token);
    const blob = await client.textToImage({
      provider: process.env.HF_PROVIDER || "hf-inference",
      model: MODEL,
      inputs: prompt,
      parameters: { width, height }
    });
    const buf = Buffer.from(await blob.arrayBuffer());
    res.json({ image: `data:${blob.type || "image/png"};base64,${buf.toString("base64")}` });
  } catch (e) {
    res.status(500).json({ error: String(e.message || e).slice(0, 300) });
  }
});
app.listen(3000, () => console.log("AI Image Server berjalan di port 3000"));
