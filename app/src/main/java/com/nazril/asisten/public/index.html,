
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Image Generator</title>
<style>
body {
      margin: 0;
        padding: 20px;
          font-family: Arial, sans-serif;
            background: #101827;
              color: white;
}
.container {
      max-width: 500px;
        margin: auto;
}
textarea, select, button {
      box-sizing: border-box;
        width: 100%;
          padding: 14px;
            margin: 10px 0;
              border-radius: 10px;
                border: 0;
                  font-size: 16px;
}
textarea { min-height: 110px; }
button {
      background: #3478e5;
        color: white;
          font-weight: bold;
}
button:disabled { opacity: .5; }
img {
      width: 100%;
        margin-top: 15px;
          border-radius: 12px;
}
#status { color: #b9d4ff; }
</style>
</head>
<body>
<div class="container">
  <h2>✦ AI Image Generator</h2>
    <p>Buat gambar dari ide kamu.</p>

      <textarea id="prompt"
          placeholder="Contoh: Robot AI lucu di kota futuristik..."></textarea>

            <select id="style">
                <option>3D</option>
                    <option>Anime</option>
                        <option>Kartun</option>
                            <option>Realistis</option>
                                <option>Poster</option>
                                    <option>Edukasi</option>
                                        <option>Lukisan</option>
                                            <option>Fantasi</option>
                                                <option>Pixel Art</option>
                                                  </select>

                                                    <button id="generate" onclick="generateImage()">
                                                        ✦ BUAT GAMBAR
                                                          </button>

                                                            <p id="status"></p>
                                                              <img id="result" hidden>

                                                                <a id="download" hidden download="gambar-ai.png">
                                                                    <button type="button">Simpan Gambar</button>
                                                                      </a>
                                                                      </div>

                                                                      <script>
                                                                      async function generateImage() {
                                                                          const prompt = document.getElementById("prompt").value.trim();
                                                                            const style = document.getElementById("style").value;
                                                                              const button = document.getElementById("generate");
                                                                                const status = document.getElementById("status");
                                                                                  const result = document.getElementById("result");
                                                                                    const download = document.getElementById("download");

                                                                                      if (!prompt) {
                                                                                            status.textContent = "Masukkan deskripsi gambar dahulu.";
                                                                                                return;
                                                                                      }

                                                                                        button.disabled = true;
                                                                                          status.textContent = "Sedang membuat gambar...";
                                                                                            result.hidden = true;
                                                                                              download.hidden = true;

                                                                                                try {
                                                                                                        const response = await fetch("/generate-image", {
                                                                                                                  method: "POST",
                                                                                                                        headers: { "Content-Type": "application/json" },
                                                                                                                              body: JSON.stringify({ prompt, style })
                                                                                                        });

                                                                                                            const data = await response.json();

                                                                                                                if (!response.ok) {
                                                                                                                          throw new Error(data.error || "Permintaan gagal.");
                                                                                                                }

                                                                                                                    result.src = data.image;
                                                                                                                        result.hidden = false;
                                                                                                                            download.href = data.image;
                                                                                                                                download.hidden = false;
                                                                                                                                    status.textContent = "Gambar berhasil dibuat!";

                                                                                                } catch (error) {
                                                                                                        status.textContent = error.message;
                                                                                                } finally {
                                                                                                        button.disabled = false;
                                                                                                }
                                                                      }
                                                                      </script>
                                                                      </body>
                                                                      </html>
                                                                      
                                                                                                        })
                                                                                      }
}